{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "../package.json",
  "identifier": "com.fukcrz.jarvis",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop-runtime.mjs",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jarvis",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime-staging": "jarvis"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMkI4RkVFNDFCNEZDNkIKUldSci9MUkI3bzhyVHBoNloxTTVyVzFRNXNON0NaWWFxY21uTHBZVmxUTFVBckc0eVhaMThHQUcK",
      "endpoints": [
        "https://github.com/fukcrz/jarvis/releases/latest/download/latest.json"
      ]
    }
  }
}
